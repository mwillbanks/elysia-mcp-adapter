{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "examples/apps-react/app.tsx",
    "examples/apps-react/build.ts",
    "examples/apps-react/index.html",
    "examples/apps-react/server.test.ts",
    "examples/apps-react/server.ts",
    "examples/apps-vanilla/app.ts",
    "examples/apps-vanilla/index.html",
    "examples/apps-vanilla/server.test.ts",
    "examples/apps-vanilla/server.ts",
    "examples/core/server.test.ts",
    "examples/core/smoke.ts",
    "examples/events/fixture-receiver.ts",
    "examples/events/provider-process.ts",
    "examples/events/server.test.ts",
    "examples/events/smoke.ts",
    "examples/events/webhook-process.ts",
    "examples/experimental/server.test.ts",
    "examples/experimental/smoke.ts",
    "examples/skills/server.test.ts",
    "examples/skills/smoke.ts",
    "scripts/check-extension-drift.ts",
    "scripts/check-packed-consumer.ts",
    "scripts/verify-app-build.ts"
  ],
  "ignorePatterns": ["website/**"],
  "ignoreDependencies": ["@mwillbanks/elysia-mcp-adapter", "collections", "elysia"],
  "ignoreUnresolvedImports": ["./dist/index.html"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependency": "error",
    "unlisted-dependency": "error",
    "circular-dependency": "error",
    "duplicate-export": "error"
  }
}
