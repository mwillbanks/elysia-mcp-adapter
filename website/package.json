    "fumadocs-ui": "^16.18.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "seroval": "1.7.7",
    "zbsearch": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
