{
  "name": "elysia-mcp-adapter-docs",
  "private": true,
  "packageManager": "bun@1.4.4",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun --bun vite build",
    "dev": "bun --bun vite dev",
