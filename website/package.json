    "fumadocs-core": "^16.17.7",
    "fumadocs-mdx": "^15.4.9",
    "fumadocs-ui": "^16.17.7",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "seroval": "1.7.0",
    "zbsearch": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fumadocs-typescript": "^5.5.2",
    "nitro": "3.0.260903-beta",
