{
  "name": "elysia-mcp-apps-vanilla-example",
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@mwillbanks/elysia-mcp-adapter": "link:@mwillbanks/elysia-mcp-adapter",
    "elysia": "1.4.30",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "build": "bun build --compile --target=browser --minify ./index.html --outdir=dist",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test --bail",
    "smoke": "bun --bun run typecheck && bun --bun run build && bun ../../scripts/verify-app-build.ts dist/index.html && bun --bun run test"
  },
  "type": "module",
  "packageManager": "bun@1.4.2"
}
