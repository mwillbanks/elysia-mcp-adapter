{
  "name": "elysia-mcp-apps-vanilla-example",
  "dependencies": {
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "private": true,
  "scripts": {
    "build": "bun build --compile --target=browser --minify ./index.html --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --bail",
    "smoke": "bun run typecheck && bun run build && bun ../../scripts/verify-app-build.ts dist/index.html && bun run test"
  },
  "type": "module"
}
