{
  "name": "@mwillbanks/elysia-mcp-adapter",
  "version": "0.3.0",
  "packageManager": "bun@1.3.14",
  "description": "Expose Elysia HTTP routes, prompts, and resources through a native-feeling MCP adapter.",
  "type": "module",
  "workspaces": [
    "examples/tasks",
    "examples/auth",
    "examples/apps-vanilla",
    "examples/apps-react"
  ],
  "license": "MIT",
  "author": "Mike Willbanks",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwillbanks/elysia-mcp-adapter.git"
  },
  "homepage": "https://mwillbanks.github.io/elysia-mcp-adapter/",
  "bugs": {
    "url": "https://github.com/mwillbanks/elysia-mcp-adapter/issues"
  },
  "keywords": [
    "elysia",
    "elysiajs",
    "mcp",
    "model-context-protocol",
    "typebox",
    "openapi"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "logo.svg",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --bail",
    "lint": "biome check",
    "format": "biome check --write",
    "fallow": "fallow --skip health",
    "fallow:health": "fallow health",
    "examples:setup": "bun link && bun install",
    "examples:build": "bun run --cwd examples/apps-vanilla build && bun run --cwd examples/apps-react build",
    "examples:typecheck": "bun run --cwd examples/tasks typecheck && bun run --cwd examples/auth typecheck && bun run --cwd examples/apps-vanilla typecheck && bun run --cwd examples/apps-react typecheck",
    "examples:test": "bun run examples:build && bun run --cwd examples/tasks test && bun run --cwd examples/auth test && bun run --cwd examples/apps-vanilla test && bun run --cwd examples/apps-react test",
    "examples:smoke": "bun run --cwd examples/tasks smoke && bun run --cwd examples/auth smoke && bun run --cwd examples/apps-vanilla smoke && bun run --cwd examples/apps-react smoke",
    "extensions:check-drift": "bun scripts/check-extension-drift.ts",
    "prepack": "bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.0.3"
  },
  "peerDependencies": {
    "elysia": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@elysiajs/openapi": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/bun": "^1.3.14",
    "elysia": "^1.4.29",
    "fallow": "^3.10.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1",
    "node": ">=20.11"
  }
}
