{
  "name": "@mwillbanks/elysia-mcp-adapter",
  "version": "0.1.0",
  "description": "Expose Elysia HTTP routes, prompts, and resources through a native-feeling MCP adapter.",
  "type": "module",
  "license": "MIT",
  "author": "Mike Willbanks",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwillbanks/elysia-mcp-adapter.git"
  },
  "keywords": [
    "elysia",
    "elysiajs",
    "mcp",
    "model-context-protocol",
    "typebox",
    "openapi"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "logo.svg",
    "AGENTS.md",
    "docs/plan/initial.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check",
    "format": "biome check --write",
    "fallow": "fallow --skip health",
    "fallow:health": "fallow health",
    "prepack": "bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "peerDependencies": {
    "elysia": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@elysiajs/openapi": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@sinclair/typebox": "^0.34.41",
    "@types/bun": "^1.3.14",
    "elysia": "^1.4.28",
    "fallow": "^3.6.0",
    "husky": "^9.1.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.1",
    "node": ">=20.11"
  }
}
